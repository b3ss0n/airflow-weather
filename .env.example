# Скопируй этот файл в .env и поменяй пароли. Файл .env не коммитить!

# Пользователь и пароль для базы метаданных Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow

# Пароль пользователя weather (база с данными проекта)
WEATHER_DB_PASSWORD=change_me_weather

# Общий секрет для Execution API. Сгенерируй случайную строку:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=change_me_to_random_string

# Только для Linux: подставь вывод команды `id -u`, чтобы не было проблем с правами на logs/
AIRFLOW_UID=50000
